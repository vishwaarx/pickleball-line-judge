# Copy to .env and fill in. start.sh loads .env automatically. Everything here is optional.

# Jev second-opinion confirmer (TypeSafe). Leave empty to run fully offline — geometry still judges every call.
TYPESAFE_API_KEY=
# TYPESAFE_API_URL=https://api.typesafe.ai/v1/systemone
# TYPESAFE_MODEL=jev-preview

# Console log level (the file log in server/logs/pickle.log is always DEBUG)
# PICKLE_LOG=INFO
